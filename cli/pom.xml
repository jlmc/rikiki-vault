<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>rikiki-vault</artifactId>
    <groupId>io.github.jlmc</groupId>
    <version>1.0.1</version>
  </parent>

  <groupId>io.github.jlmc</groupId>
  <artifactId>cli</artifactId>
  <version>1.0.1</version>

  <name>cli</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <main.class>io.github.jlmc.rikikivault.cli.Main</main.class>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.11.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.jlmc</groupId>
      <artifactId>core</artifactId>
      <version>1.0.1</version>
    </dependency>
    <!-- Binds the SLF4J API that JGit/mina-sshd already log through (core stays binding-agnostic,
         only this application module picks one) to plain, dependency-free console output - no
         XML config file needed, unlike Logback. Configured via simplelogger.properties. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.18</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>rikiki-vault</finalName>
    <plugins>
      <plugin>
        <!-- Thin jar (project classes only) - no fat/shaded jar. Its manifest's Class-Path is
             auto-generated below to list every jar copy_dependencies places in target/lib/. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!-- Copies every runtime dependency, unmerged, into target/lib/ - this is both what
             `java -jar target/rikiki-vault.jar` needs alongside the thin jar, and the exact
             input layout jpackage (scripts/package.sh) expects (its "input" flag). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
