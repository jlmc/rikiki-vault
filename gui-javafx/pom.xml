<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>rikiki-vault</artifactId>
    <groupId>io.github.jlmc</groupId>
    <version>1.0.3-SNAPSHOT</version>
  </parent>

  <groupId>io.github.jlmc</groupId>
  <artifactId>rikiki-vault-gui-javafx</artifactId>
  <version>1.0.3-SNAPSHOT</version>

  <name>gui-javafx</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <javafx.version>21.0.4</javafx.version>
    <ikonli.version>12.4.0</ikonli.version>
    <!-- mvn javafx:run bypasses the "java -jar" launcher check and can point at the
         Application subclass directly; the packaged jar/jpackage app cannot (see Launcher). -->
    <app.class>io.github.jlmc.rikikivault.gui.App</app.class>
    <main.class>io.github.jlmc.rikikivault.gui.Launcher</main.class>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.11.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.jlmc</groupId>
      <artifactId>rikiki-vault-core</artifactId>
      <version>1.0.3-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-web</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-javafx</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-feather-pack</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.22.2</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.3</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark</artifactId>
      <version>0.22.0</version>
    </dependency>
    <!-- Same binding as the cli module - lets JGit/mina-sshd log to whatever terminal launched
         `mvn javafx:run` (or the packaged app), instead of being silently dropped. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.18</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>rikiki-vault-gui</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Single source of truth for the app icon - the same branding/icon.* files jpackage
           already uses (scripts/package.sh) become available on the runtime classpath too, so
           App.java can set the window/dock icon without duplicating the file into resources/. -->
      <resource>
        <directory>../branding</directory>
        <targetPath>branding</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <executions>
          <execution>
            <!-- Usage: mvn -pl gui-javafx javafx:run -->
            <id>default-cli</id>
            <configuration>
              <mainClass>${app.class}</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Thin jar (project classes only) - no fat/shaded jar. Its manifest's Class-Path is
             auto-generated below to list every jar copy_dependencies places in target/lib/. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!-- Copies every runtime dependency, unmerged, into target/lib/ - this is both what
             `java -jar target/rikiki-vault-gui.jar` needs alongside the thin jar, and the exact
             input layout jpackage (scripts/package.sh) expects (its "input" flag). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
