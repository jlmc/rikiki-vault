<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.jlmc.rikikivault.gui.controllers.SettingsController"
            styleClass="settings-view">
    <top>
        <Label text="%settings.title" styleClass="title">
            <BorderPane.margin>
                <Insets top="20" right="20" bottom="8" left="20"/>
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <BorderPane.margin>
                <Insets top="0" right="20" bottom="0" left="20"/>
            </BorderPane.margin>
        </TabPane>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <BorderPane.margin>
                <Insets top="12" right="20" bottom="20" left="20"/>
            </BorderPane.margin>
            <Button text="%common.close" styleClass="compact-button" onAction="#onClose">
                <tooltip>
                    <Tooltip text="%settings.close.tooltip"/>
                </tooltip>
            </Button>
            <Button fx:id="saveButton" text="%common.save" styleClass="compact-button, primary-button" onAction="#onSave">
                <tooltip>
                    <Tooltip text="%settings.save.tooltip"/>
                </tooltip>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
