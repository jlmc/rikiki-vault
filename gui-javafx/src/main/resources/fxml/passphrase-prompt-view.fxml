<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import io.github.jlmc.rikikivault.gui.controls.RevealablePasswordField?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.jlmc.rikikivault.gui.controllers.PassphrasePromptController"
      styleClass="passphrase-prompt-view" spacing="16" alignment="CENTER">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>
    <Label fx:id="titleLabel" styleClass="title" wrapText="true" maxWidth="360" textAlignment="CENTER"/>
    <Label text="%passphrasePrompt.subtitle" styleClass="subtitle" wrapText="true" maxWidth="360" textAlignment="CENTER"/>
    <RevealablePasswordField fx:id="passphraseField" prefWidth="240" promptText="%passphrasePrompt.field.prompt"/>
    <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false" wrapText="true" maxWidth="360"/>
    <HBox spacing="8" alignment="CENTER">
        <ProgressIndicator fx:id="progress" maxWidth="20" maxHeight="20" visible="false"/>
        <Button fx:id="unlockButton" text="%passphrasePrompt.unlockButton" styleClass="primary-button" onAction="#onUnlock" defaultButton="true"/>
        <Button fx:id="cancelButton" text="%passphrasePrompt.cancelButton" onAction="#onCancelAction" cancelButton="true"/>
    </HBox>
</VBox>
