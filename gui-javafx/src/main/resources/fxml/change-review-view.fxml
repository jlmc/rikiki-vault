<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.jlmc.rikikivault.gui.ChangeReviewController"
      styleClass="change-review-view" spacing="16">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="%changeReview.title" styleClass="title"/>
    <TableView fx:id="changesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="selectedColumn" text="" prefWidth="36"/>
            <TableColumn fx:id="statusColumn" text="%mainWindow.column.status" prefWidth="70"/>
            <TableColumn fx:id="pathColumn" text="%mainWindow.column.file" prefWidth="420"/>
        </columns>
    </TableView>
    <Label text="%changeReview.commitMessage.label"/>
    <TextField fx:id="commitMessageField" promptText="%changeReview.commitMessage.prompt"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <ProgressIndicator fx:id="progress" maxWidth="24" maxHeight="24" visible="false"/>
        <Label fx:id="statusLabel" styleClass="status-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="%common.cancel" onAction="#onCancel"/>
        <Button fx:id="publishButton" text="%changeReview.publishButton" styleClass="primary-button" onAction="#onPublish"/>
    </HBox>
</VBox>
