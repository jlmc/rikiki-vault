<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import io.github.jlmc.rikikivault.gui.controls.RevealablePasswordField?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.jlmc.rikikivault.gui.controllers.GitAuthSettingsPanel"
      styleClass="git-auth-panel" spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="%gitAuthPanel.subtitle" styleClass="subtitle" wrapText="true"/>
    <Label fx:id="activeTypeLabel" styleClass="section-title"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="git-auth-scroll">
        <VBox spacing="20">
            <padding>
                <Insets top="4" right="4" bottom="4" left="4"/>
            </padding>
            <RadioButton fx:id="noneRadio" text="%gitAuthPanel.type.none">
                <toggleGroup>
                    <ToggleGroup fx:id="authTypeGroup"/>
                </toggleGroup>
            </RadioButton>

            <VBox spacing="8">
                <RadioButton fx:id="sshRadio" text="%gitAuthPanel.type.ssh" toggleGroup="$authTypeGroup"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="sshKeyPathField" editable="false" prefWidth="280"/>
                    <Button text="%gitAuthPanel.chooseKey" onAction="#onChooseSshKey">
                        <tooltip>
                            <Tooltip text="%gitAuthPanel.chooseKey.tooltip"/>
                        </tooltip>
                    </Button>
                </HBox>
                <Button text="%gitAuthPanel.removeKey" onAction="#onClearSshKey">
                    <tooltip>
                        <Tooltip text="%gitAuthPanel.removeKey.tooltip"/>
                    </tooltip>
                </Button>
            </VBox>

            <VBox spacing="8">
                <RadioButton fx:id="tokenRadio" text="%gitAuthPanel.type.token" toggleGroup="$authTypeGroup"/>
                <RevealablePasswordField fx:id="tokenField" prefWidth="220"/>
                <Button text="%gitAuthPanel.removeToken" onAction="#onClearToken">
                    <tooltip>
                        <Tooltip text="%gitAuthPanel.removeToken.tooltip"/>
                    </tooltip>
                </Button>
            </VBox>

            <VBox spacing="8">
                <RadioButton fx:id="httpRadio" text="%gitAuthPanel.type.http" toggleGroup="$authTypeGroup"/>
                <TextField fx:id="httpUsernameField" promptText="%gitAuthPanel.usernamePrompt" prefWidth="220"/>
                <RevealablePasswordField fx:id="httpPasswordField" prefWidth="220"/>
                <Button text="%gitAuthPanel.removeHttpBasic" onAction="#onClearHttpBasic">
                    <tooltip>
                        <Tooltip text="%gitAuthPanel.removeHttpBasic.tooltip"/>
                    </tooltip>
                </Button>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
