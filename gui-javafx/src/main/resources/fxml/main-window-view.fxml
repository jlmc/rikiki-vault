<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.jlmc.rikikivault.gui.MainWindowController">
    <top>
        <HBox styleClass="toolbar" spacing="12" alignment="CENTER_LEFT">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label fx:id="vaultPathLabel" styleClass="toolbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="fingerprintLabel" styleClass="fingerprint-label"/>
            <Label fx:id="remoteSyncLabel" styleClass="status-label"/>
            <Button fx:id="refreshButton" text="Atualizar" onAction="#onRefresh"/>
            <Button fx:id="pullButton" text="Pull" onAction="#onPull"/>
            <Button fx:id="manageAccessButton" text="Gerir acesso..." onAction="#onManageAccess"/>
            <Button fx:id="settingsButton" text="Configurações..." onAction="#onOpenSettings"/>
            <Button fx:id="publishButton" text="Publicar..." styleClass="primary-button" onAction="#onPublish"/>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.45">
            <TreeTableView fx:id="fileTable" styleClass="file-table" showRoot="false">
                <columns>
                    <TreeTableColumn fx:id="nameColumn" text="Ficheiro" prefWidth="330"/>
                    <TreeTableColumn fx:id="statusColumn" text="Estado" prefWidth="90"/>
                </columns>
            </TreeTableView>
            <BorderPane>
                <top>
                    <HBox fx:id="editorToolbar" styleClass="editor-toolbar" spacing="8" alignment="CENTER_LEFT">
                        <padding>
                            <Insets top="8" right="8" bottom="8" left="8"/>
                        </padding>
                        <Button fx:id="editToggleButton" text="Editar" onAction="#onToggleEdit" disable="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="saveButton" text="Save" onAction="#onSave" managed="false" visible="false"/>
                        <Button fx:id="encryptButton" text="Encrypt" onAction="#onEncrypt" managed="false" visible="false"/>
                        <Button fx:id="revertButton" text="Revert" onAction="#onRevert" managed="false" visible="false"/>
                        <Button fx:id="diffButton" text="Diff" onAction="#onDiff" managed="false" visible="false"/>
                    </HBox>
                </top>
                <center>
                    <StackPane fx:id="previewContainer" styleClass="preview-container"/>
                </center>
            </BorderPane>
        </SplitPane>
    </center>
</BorderPane>
